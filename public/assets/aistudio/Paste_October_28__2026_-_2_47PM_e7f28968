                <div className="flex items-center gap-3">
                  <label className="text-xs font-bold uppercase text-slate-500">Pilih Kompetensi / KPI:</label>
                  <select
                    value={selectedCompId}
                    onChange={(e) => setSelectedCompId(e.target.value)}
